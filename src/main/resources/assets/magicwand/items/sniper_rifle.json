{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui",
          "ground",
          "fixed"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "magicwand:item/sniper_rifle"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:condition",
      "property": "minecraft:custom_model_data",
      "index": 0,
      "on_true": {
        "type": "minecraft:model",
        "model": "magicwand:item/sniper_rifle_3d_bolt"
      },
      "on_false": {
        "type": "minecraft:model",
        "model": "magicwand:item/sniper_rifle_3d"
      }
    }
  }
}